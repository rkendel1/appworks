{
  "name": "appworks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AppWorks: discover, package, compose and incrementally replace business functionality, on top of AppPort.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "tsc -b tsconfig.build.json --pretty && tsc -p tsconfig.test.json",
    "test": "vitest run && vitest run --config vitest.processes.config.ts",
    "boundary:check": "node scripts/check-boundary.mjs",
    "release:check": "node scripts/check-release.mjs",
    "publish:packages": "node scripts/publish-packages.mjs",
    "extraction:memos": "node extractions/memos-reactions/scripts/extract.mjs",
    "serve": "tsc -b tsconfig.build.json && node packages/workspace/dist/cli.js serve",
    "appworks": "node packages/workspace/dist/cli.js",
    "test:fast": "vitest run",
    "test:processes": "vitest run --config vitest.processes.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": "https://github.com/rkendel1/appworks.git"
}
